PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=sevahub
JWT_SECRET=change-me-to-a-long-random-secret

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Razorpay server-side credentials. Never commit real keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
PLATFORM_FEE_PERCENT=2

# Real AI (server-side only). Use any OpenAI-compatible chat-completions provider.
AI_API_KEY=YOUR_AI_API_KEY
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=YOUR_MODEL

# Cooperative Admin Dashboard. Set real values only in Render/local .env.
# Never commit the real admin password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-private-admin-password
ADMIN_JWT_EXPIRES_IN=8h
